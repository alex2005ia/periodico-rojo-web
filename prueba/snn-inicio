<!-- Hace un fech a Inicio/GetNoticias cuando se carga la pagina-->
<div id="url_Inicio_GetNoticias"
     data-request-url='/SITIO_OFICIAL_PC/Inicio/GetNoticias'
     data-nota-url='/SITIO_OFICIAL_PC/Nota/Nota'
     style="display:none"></div>

<script>
    (function () {
        var holder = document.getElementById('sn-news-cards');
        var cfg = document.getElementById('url_Inicio_GetNoticias');
        if (!holder || !cfg) return;

        var meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

        function fmtFecha(s) {
            if (!s) return '';
            var p = s.substring(0, 10).split('-');
            if (p.length === 3) return parseInt(p[2], 10) + ' ' + meses[parseInt(p[1], 10) - 1] + ' ' + p[0];
            return s;
        }

        function esc(t) {
            var d = document.createElement('div');
            d.textContent = (t == null) ? '' : t;
            return d.innerHTML;
        }

        fetch(cfg.getAttribute('data-request-url'))
            .then(function (r) { return r.text(); })
            .then(function (xmlText) {
                var xml = new DOMParser().parseFromString(xmlText, 'application/xml');
                var root = xml.documentElement;
                var rows = root ? Array.prototype.slice.call(root.children) : [];
                if (!rows.length) {
                    var sec = document.querySelector('.sn-home-news');
                    if (sec) sec.style.display = 'none';
                    return;
                }
                var html = '';
                var imagenes = []; // base64 por noticia; se asignan reducidas despues
                rows.slice(0, 10).forEach(function (row, i) {
                    function g(tag) { var el = row.getElementsByTagName(tag)[0]; return el ? el.textContent : ''; }
                    var id = g('Id_Entrada'), fecha = g('FechaHoraPub'), titulo = g('Titulo'), entrada = g('Entrada'), img = g('Imagen_Encabezado');
                    imagenes[i] = img || '';
                    var media = img ? '<img data-noticia-img="' + i + '" alt="">' : '';
                    html += '<article class="sn-home-news-card" onclick="snAbrirNota(\'' + esc(id) + '\')">'
                        + '<div class="sn-home-news-card__media">' + media + '</div>'
                        + '<div class="sn-home-news-card__body">'
                        + '<span class="sn-home-news-card__date">' + fmtFecha(fecha) + '</span>'
                        + '<h3 class="sn-home-news-card__title">' + esc(titulo) + '</h3>'
                        + '<p class="sn-home-news-card__excerpt">' + esc(entrada) + '</p>'
                        + '<span class="sn-home-news-card__link"><span class="sn-home-news-card__link-text">Leer noticia</span><span class="sn-home-news-card__arrow" aria-hidden="true">&#8599;</span></span>'
                        + '</div>'
                        + '</article>';
                });
                holder.innerHTML = '<div class="sn-home-news__track">'
                    + '<div class="sn-home-news__set">' + html + '</div>'
                    + '<div class="sn-home-news__set" aria-hidden="true">' + html + '</div>'
                    + '<div class="sn-home-news__set" aria-hidden="true">' + html + '</div>'
                    + '</div>';

                // Las imagenes llegan grandes (~1100px) pero se muestran a ~300px, y el
                // carrusel las repite 3 veces: ~95 MB de memoria grafica. Safari en
                // iPhone (y PCs con poca memoria) descarta la capa y las tarjetas se
                // quedan en blanco. Se reducen una vez por noticia y las 3 copias
                // comparten el mismo bitmap chico (~10 MB en total).
                asignarImagenesReducidas(holder, imagenes);

                // Marquee manejado por JavaScript (requestAnimationFrame) en lugar de
                // animacion CSS. En Safari/iOS la animacion CSS combinada con el
                // mask-image del contenedor se congela tras la primera vuelta; moviendo
                // el transform por JS el desplazamiento nunca se detiene.
                iniciarMarqueeNoticias(holder);
            })
            .catch(function (e) { console.error('Error al cargar noticias del inicio:', e); });
    })();

    function asignarImagenesReducidas(holder, imagenes) {
        imagenes.forEach(function (b64, i) {
            if (!b64) return;
            var completa = 'data:image/png;base64,' + b64;
            var destinos = holder.querySelectorAll('[data-noticia-img="' + i + '"]');
            function usarOriginal() {
                Array.prototype.forEach.call(destinos, function (el) { el.src = completa; });
            }
            var im = new Image();
            im.onload = function () {
                try {
                    var maxW = 640; // ~2x el ancho mostrado (retina)
                    var escala = Math.min(1, maxW / im.naturalWidth);
                    var c = document.createElement('canvas');
                    c.width = Math.max(1, Math.round(im.naturalWidth * escala));
                    c.height = Math.max(1, Math.round(im.naturalHeight * escala));
                    c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
                    c.toBlob(function (blob) {
                        if (!blob) { usarOriginal(); return; }
                        var url = URL.createObjectURL(blob);
                        Array.prototype.forEach.call(destinos, function (el) { el.src = url; });
                    }, 'image/jpeg', 0.85);
                } catch (e) { usarOriginal(); }
            };
            im.onerror = usarOriginal;
            im.src = completa;
        });
    }

    function iniciarMarqueeNoticias(holder) {
        var track = holder.querySelector('.sn-home-news__track');
        if (!track) return;

        track.style.animation = 'none';
        var offset = 0, oneSet = 0, last = null;
        var hoverPause = false, dragging = false;
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        holder.addEventListener('mouseenter', function () { hoverPause = true; });
        holder.addEventListener('mouseleave', function () { hoverPause = false; });

        function aplicar() {
            if (oneSet) offset = ((offset % oneSet) + oneSet) % oneSet; // permite retroceder (offset negativo)
            track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';
        }

        // Vuelve a medir la tira cuando cambia su ancho (en iOS la barra de URL
        // al ocultarse redimensiona el viewport y el ancho medido queda viejo,
        // rompiendo el punto de enlace del bucle).
        function medir() {
            var w = track.scrollWidth / 3;
            if (w && w !== oneSet) {
                if (oneSet) offset = offset * (w / oneSet); // conserva la posicion proporcional
                oneSet = w;
                aplicar();
            }
        }
        window.addEventListener('resize', medir);
        window.addEventListener('orientationchange', medir);
        if (window.ResizeObserver) { new ResizeObserver(medir).observe(track); }

        // Arrastre con mouse o dedo para avanzar/retroceder las noticias.
        // touch-action: pan-y (CSS) deja que el scroll vertical siga funcionando en celular.
        var startX = 0, startOffset = 0, moved = 0;
        holder.addEventListener('pointerdown', function (e) {
            if (e.button !== undefined && e.button !== 0) return; // solo boton izquierdo
            medir();
            dragging = true; moved = 0;
            startX = e.clientX; startOffset = offset;
            holder.classList.add('is-dragging');
            if (holder.setPointerCapture) { try { holder.setPointerCapture(e.pointerId); } catch (err) { } }
        });
        holder.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            var dx = e.clientX - startX;
            if (Math.abs(dx) > moved) moved = Math.abs(dx);
            offset = startOffset - dx;
            aplicar();
        });
        function finDrag() {
            dragging = false;
            holder.classList.remove('is-dragging');
        }
        holder.addEventListener('pointerup', finDrag);
        holder.addEventListener('pointercancel', finDrag);
        // Si hubo arrastre, no abrir la noticia al soltar
        holder.addEventListener('click', function (e) {
            if (moved > 8) { e.stopPropagation(); e.preventDefault(); moved = 0; }
        }, true);
        holder.addEventListener('dragstart', function (e) { e.preventDefault(); });

        // Respeta la preferencia de reducir movimiento (accesibilidad):
        // sin desplazamiento automatico, pero el arrastre manual si funciona.
        if (reduceMotion) return;

        function frame(ts) {
            if (!oneSet) medir(); // ancho de una de las 3 tiras
            if (last === null) last = ts;
            var dt = (ts - last) / 1000;
            last = ts;
            // iOS Safari suspende requestAnimationFrame durante el scroll; al
            // reanudarse dt trae segundos acumulados y la tira pegaba un salto
            // enorme (se "aceleraba" y desaparecian las noticias). Se limita a
            // un frame normal para que retome suave donde iba.
            if (dt > 0.1) dt = 0.016;
            if (!hoverPause && !dragging && oneSet) {
                offset = (offset + (oneSet / 65) * dt) % oneSet; // ~65s por vuelta completa de una tira
                track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';
            }
            requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
    }

    function snAbrirNota(id) {
        if (!id) return;
        var cfg = document.getElementById('url_Inicio_GetNoticias');
        var base = cfg ? cfg.getAttribute('data-nota-url') : '/Nota/Nota';
        location.href = base + '?Id=' + id;
    }
</script>



