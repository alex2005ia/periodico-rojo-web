<script>
    (function () {
        function initHeroClick() {
            var el = document.getElementById('inicioHeroCarousel');
            if (!el) return;
            if (!window.bootstrap || !bootstrap.Carousel) {
                // Bootstrap aun no carga; reintentar en breve
                setTimeout(initHeroClick, 200);
                return;
            }
            var carousel = bootstrap.Carousel.getOrCreateInstance(el);
            // Avanzar al siguiente al hacer clic en cualquier parte de la foto
            el.querySelectorAll('.sn-home-hero-slide > img').forEach(function (img) {
                img.style.cursor = 'pointer';
                img.addEventListener('click', function () { carousel.next(); });
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initHeroClick);
        } else {
            initHeroClick();
        }
    })();
</script>
