        }

        .sn-home-navbar .brand img {
            height: 32px !important;
        }

        .sn-home-navbar .sn-home-toggler {
            display: inline-flex;
        }

        /* Menu colapsable en panel vertical (tipo cristal, igual a la barra) */
        .sn-home-navbar .navbar-collapse {
            display: block !important;
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            right: 0;
            width: 100%;
            border-radius: 18px;
            background: rgba(0, 56, 128, 0.95);
            backdrop-filter: blur(10px) saturate(120%);
            -webkit-backdrop-filter: blur(10px) saturate(120%);
            border: 1px solid rgba(163, 206, 255, 0.45);
            box-shadow: 0 20px 44px rgba(2, 20, 48, 0.35);
            overflow: hidden;
            max-height: 0;
            padding: 0 10px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-12px);
            transform-origin: top center;
            transition: opacity 260ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.25, 1), max-height 340ms ease, padding 240ms ease, visibility 0s linear 340ms;
        }

        .sn-home-navbar .navbar-collapse.is-open {
            max-height: 80vh;
            padding: 10px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            overflow-y: auto;
            transition: opacity 260ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.25, 1), max-height 340ms ease, padding 240ms ease, visibility 0s;
        }

        .sn-home-navbar .navbar-nav {
            flex-direction: column !important;
            align-items: stretch;
            min-width: 0;
            width: 100%;
            gap: 2px;
        }

