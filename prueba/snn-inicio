        width: 24px;
        height: 2px;
        border-radius: 2px;
        background: #ffffff;
        transition: transform 260ms ease, opacity 200ms ease;
    }

    .sn-home-navbar .sn-home-toggler.is-open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }

    .sn-home-navbar .sn-home-toggler.is-open span:nth-child(2) {
        opacity: 0;
