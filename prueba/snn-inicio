    <script>
        (function () {
            var btn = document.querySelector('.sn-home-toggler');
            var menu = document.getElementById('navbarNavDropdown');
            if (!btn || !menu) return;

            function setOpen(open) {
                menu.classList.toggle('is-open', open);
                btn.classList.toggle('is-open', open);
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                setOpen(!menu.classList.contains('is-open'));
            });

            // Cerrar el menu al elegir un enlace de navegacion (no los que abren submenu)
            menu.querySelectorAll('.nav-link:not(.dropdown-toggle), .dropdown-item').forEach(function (a) {
                a.addEventListener('click', function () { setOpen(false); });
            });

            // Cerrar al tocar fuera del menu
            document.addEventListener('click', function (e) {
                if (menu.classList.contains('is-open') && !menu.contains(e.target) && !btn.contains(e.target)) {
                    setOpen(false);
                }
            });
        })();
    </script>

