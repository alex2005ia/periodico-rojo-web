		<pubDate>Sun, 16 Jun 2024 20:47:56 +0000</pubDate>
				<category><![CDATA[Avisos]]></category>
		<category><![CDATA[Comunicados]]></category>
		<category><![CDATA[Sin Categorizar]]></category>
