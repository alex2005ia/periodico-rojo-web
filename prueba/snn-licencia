    .sn-home-navbar .nav-link {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0;
        opacity: 0.95;
        transition: opacity 150ms ease, text-shadow 150ms ease;
    }

    .sn-home-navbar .nav-link:hover,
    .sn-home-navbar .nav-link:focus-visible {
        opacity: 1;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.28);
