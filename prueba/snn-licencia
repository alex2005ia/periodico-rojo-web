            height: 32px !important;
        }

        .sn-home-navbar .sn-home-toggler {
            display: inline-flex;
        }

        /* Menu colapsable en panel vertical (tipo cristal, igual a la barra) */
        .sn-home-navbar .navbar-collapse {
            display: block !important;
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            right: 0;
            width: 100%;
