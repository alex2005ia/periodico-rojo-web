		<title>Prepara San Pedro panteones municipales para el Día de Muertos</title>
		<link>https://blog.sanpedro.gob.mx/news/prepara-san-pedro-panteones-municipales-para-el-dia-de-muertos/</link>
		
		<dc:creator><![CDATA[claudiag]]></dc:creator>
		<pubDate>Fri, 30 Oct 2026 21:57:07 +0000</pubDate>
				<category><![CDATA[Comunicados]]></category>
