		<title>Refrenda San Pedro certificación internacional Green Flag Award para 10 parques</title>
		<link>https://blog.sanpedro.gob.mx/news/refrenda-san-pedro-certificacion-internacional-green-flag-award-para-10-parques/</link>
		
		<dc:creator><![CDATA[claudiag]]></dc:creator>
		<pubDate>Fri, 23 Oct 2026 10:43:00 +0000</pubDate>
				<category><![CDATA[Comunicados]]></category>
