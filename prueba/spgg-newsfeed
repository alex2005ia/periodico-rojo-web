		<title>Anuncia San Pedro la 28ª edición del Kilómetro del Juguete</title>
		<link>https://blog.sanpedro.gob.mx/news/anuncia-san-pedro-la-28a-edicion-del-kilometro-del-juguete/</link>
		
		<dc:creator><![CDATA[claudiag]]></dc:creator>
		<pubDate>Mon, 09 Nov 2026 11:46:00 +0000</pubDate>
				<category><![CDATA[Comunicados]]></category>
