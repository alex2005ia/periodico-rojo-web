---
// Bloque «Próximos eventos» de la portada y de cada municipio.
// Si no hay eventos por venir, no se muestra (ni al compilar ni en el navegador).
import EventoFila from "./EventoFila.astro";
import { eventosPublicados, separar } from "../lib/eventos";
import { nombreMunicipio } from "../lib/sitio";

interface Props {
  municipio?: string;
  limite?: number;
}
const { municipio, limite = 3 } = Astro.props;
const { proximos } = separar(await eventosPublicados(municipio));
const agenda = municipio ? `/agenda?municipio=${municipio}` : "/agenda";
---

{proximos.length > 0 && (
  <section class="contenedor seccion" aria-labelledby="proximos-eventos" data-seccion-eventos data-ocultar-vacia>
    <div class="seccion-cabeza">
      <h2 id="proximos-eventos">Próximos eventos{municipio && ` en ${nombreMunicipio(municipio)}`}</h2>
      <a class="todos" href={agenda}>Ver la agenda <span aria-hidden="true">→</span></a>
    </div>
    <ul class="eventos" data-lista-eventos="proximos" data-limite={limite}>
      {/* Se envían todos: si uno pasa, el navegador muestra el siguiente. Sin JavaScript se respeta el límite. */}
      {proximos.map((e, i) => <EventoFila evento={e} conMunicipio={!municipio} oculto={i >= limite} />)}
    </ul>
  </section>
)}

<style>
  .eventos { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linea); }
  .todos { color: var(--rojo); font-size: 0.85rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .todos:hover { text-decoration: underline; }
</style>
