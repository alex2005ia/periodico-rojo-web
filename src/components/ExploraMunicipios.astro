---
import { MUNICIPIOS } from "../lib/sitio";
---

<section class="contenedor seccion" aria-labelledby="explora">
  <div class="seccion-cabeza"><h2 id="explora">Explora tu municipio</h2></div>
  <ol class="municipios">
    {MUNICIPIOS.map((m, i) => (
      <li>
        <a href={`/municipios/${m.id}`}>
          <span class="numero">{String(i + 1).padStart(2, "0")}</span>
          <span class="nombre">{m.nombre}</span>
          <span class="ver">Ver edición <span aria-hidden="true">↗</span></span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .municipios {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    border-top: 1px solid var(--linea);
  }
  a {
    display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: baseline; gap: 12px;
    padding: 18px 4px; border-bottom: 1px solid var(--linea); text-decoration: none;
  }
  a:hover .nombre { color: var(--rojo); }
  .numero { color: var(--rojo); font-weight: 700; font-size: 0.8rem; }
  .nombre { font-family: var(--serif); font-weight: 650; font-size: 1.2rem; }
  .ver { color: var(--tinta-suave); font-size: 0.8rem; }
</style>
