---
// Identificación visual del periódico cuando una nota no tiene fotografía (ver «Sobre el periódico»).
interface Props { municipio?: string }
const { municipio } = Astro.props;
---

<div class="sello">
  <span class="nombre">PERIÓDICO <span>ROJO</span></span>
  {municipio && <span class="municipio">{municipio}</span>}
</div>

<style>
  .sello {
    width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; background: #ece8e0; border-top: 4px solid var(--rojo);
  }
  .nombre { font-family: var(--serif); font-weight: 650; font-size: 1.3rem; letter-spacing: -0.01em; }
  .nombre span { color: var(--rojo); }
  .municipio { font-size: 0.72rem; color: var(--tinta-suave); }
</style>
