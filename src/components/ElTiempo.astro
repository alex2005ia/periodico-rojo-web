---
// El tiempo por municipio. Los datos llegan del navegador a /api/clima (función de Cloudflare con MET Norway).
// Gráfica por hora con franjas de madrugada, mañana, tarde y noche; dibujos según el cielo y la intensidad de
// la lluvia; la lluvia se describe con palabras (la fuente no publica probabilidad de lluvia para la zona).
import { MUNICIPIOS } from "../lib/sitio";

interface Props { municipio?: string }
const { municipio = "monterrey" } = Astro.props;
---

<section class="contenedor seccion tiempo" aria-labelledby="tiempo-titulo" data-tiempo data-inicial={municipio}>
  <div class="cabeza">
    <div>
      <p class="antetitulo">Para organizar tu día</p>
      <h2 id="tiempo-titulo">El tiempo en tu municipio</h2>
      <p class="sub">Consulta el día y desliza para explorar sus horarios</p>
    </div>
    <label class="selector">
      <span>Consultar municipio</span>
      <select data-tiempo-municipio aria-label="Municipio del pronóstico">
        {MUNICIPIOS.map((m) => <option value={m.id} selected={m.id === municipio}>{m.nombre}</option>)}
      </select>
    </label>
  </div>

  <p class="estado" data-tiempo-estado role="status" aria-live="polite">Cargando el pronóstico…</p>
  <noscript><p class="estado">Activa JavaScript para ver el pronóstico, o consulta el <a href="https://smn.conagua.gob.mx/es/">SMN</a>.</p></noscript>
  <button type="button" class="reintentar" data-tiempo-reintentar hidden>Volver a intentar</button>

  <div class="panel" data-tiempo-cuerpo hidden>
    <div class="lectura">
      <p class="lugar" data-t="lugar"></p>
      <p class="cuando" data-t="cuando"></p>
      <div class="grados"><span class="icono-grande" data-t="icono" aria-hidden="true"></span><strong data-t="temp"></strong><span class="unidad">°C</span></div>
      <p class="cielo" data-t="cielo"></p>
      <p class="lluvia-texto" data-t="lluvia"></p>
      <p class="detalle" data-t="viento"></p>
      <p class="detalle" data-t="rango"></p>
      <p class="detalle" data-t="sol"></p>
    </div>
    <div class="grafica-caja">
      <div class="grafica-cabeza">
        <div>
          <h3 data-t="horas-titulo">Pronóstico por hora</h3>
          <p class="detalle" data-t="horas-sub"></p>
        </div>
        <div class="flechas">
          <button type="button" data-t="antes" aria-label="Hora anterior">←</button>
          <span data-t="hora-elegida"></span>
          <button type="button" data-t="despues" aria-label="Hora siguiente">→</button>
        </div>
      </div>
      <div class="grafica" data-t="grafica-scroll">
        <svg data-t="grafica" role="img" aria-label="Temperatura y lluvia por hora"></svg>
      </div>
      <input class="barra" type="range" min="0" max="0" value="0" data-t="barra" aria-label="Elegir hora del pronóstico" />
      <p class="nota">Desliza la barra o usa las flechas para cambiar de hora. Hora de Nuevo León.</p>
    </div>
  </div>

  <div data-tiempo-dias-caja hidden>
    <h3 class="dias-titulo">Los próximos siete días <span>Elige un día para ver sus horarios</span></h3>
    <ol class="dias" data-t="dias"></ol>
  </div>

  <details class="explica">
    <summary>¿Cómo describimos la lluvia?</summary>
    <ul>
      <li><strong>Chispea:</strong> gotas aisladas; casi no moja.</li>
      <li><strong>Lluvia ligera:</strong> moja, pero un paraguas basta.</li>
      <li><strong>Lluvia:</strong> constante; puede haber charcos.</li>
      <li><strong>Lluvia fuerte:</strong> abundante; posibles encharcamientos.</li>
      <li><strong>Tormenta eléctrica:</strong> se prevén rayos; evita espacios abiertos.</li>
    </ul>
    <p>La fuente no publica la probabilidad de lluvia para esta zona, por eso no mostramos porcentajes. La palabra
       resume la cantidad prevista en el intervalo.</p>
  </details>
  <p class="creditos" data-t="actualizado"></p>
  <p class="creditos">Referencia: cabecera municipal; puede variar entre colonias y montañas. Horarios de Nuevo León.
    El cielo y la lluvia describen el intervalo indicado, no una hora exacta de inicio. El pronóstico puede cambiar.</p>
  <p class="creditos">Datos de <a href="https://www.met.no/en" rel="noopener">MET Norway</a>, instituto meteorológico de
    Noruega · <a data-t="fuente" href="https://api.met.no/" rel="noopener">Fuente</a> ·
    <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>. Presentación y traducción de
    Periódico Rojo. <a href="https://smn.conagua.gob.mx/es/" rel="noopener">Consulta avisos del SMN</a>.</p>
</section>

<script>
  type Lluvia = { level: number; label: string };
  type Periodo = { time: string; temperature: number; wind: number; condition: { label: string };
    periodHours: number; precipitation: number; sky: string; isDay: boolean; phase: string; rain: Lluvia };
  type Dia = { date: string; minimum: number; maximum: number; partial: boolean; condition: { label: string };
    sky: string; rain: Lluvia; sunrise: string; sunset: string };
  type Clima = { name: string; latitude: number; longitude: number; updatedAt: string | null; current: Periodo;
    days: Dia[]; periods: Periodo[] };

  const ZONA = "America/Monterrey";
  const LLAVE = "periodico-rojo:municipio-clima";
  const SVG = "http://www.w3.org/2000/svg";
  const horaFmt = new Intl.DateTimeFormat("es-MX", { timeZone: ZONA, hour: "numeric", minute: "2-digit" });
  const horaCorta = new Intl.DateTimeFormat("es-MX", { timeZone: ZONA, hour: "numeric" });
  const diaFmt = new Intl.DateTimeFormat("es-MX", { timeZone: ZONA, weekday: "short", day: "numeric", month: "short" });
  const fechaFmt = new Intl.DateTimeFormat("es-MX", { timeZone: ZONA, day: "numeric", month: "short", year: "numeric", hour: "numeric", minute: "2-digit" });
  const diaLocal = new Intl.DateTimeFormat("en-CA", { timeZone: ZONA, year: "numeric", month: "2-digit", day: "2-digit" });
  const n = (x: number) => (Math.round(x * 10) / 10).toLocaleString("es-MX");
  const mayuscula = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);
  const MOMENTO: Record<string, string> = { madrugada: "Madrugada", "mañana": "Mañana", tarde: "Tarde", noche: "Noche" };

  // ---------- dibujos (propios, en SVG): el sol o la luna según la hora; gotas según la intensidad
  const SOL = `<circle cx="16" cy="16" r="6" fill="#f2b233"/><g stroke="#f2b233" stroke-width="2" stroke-linecap="round">${
    [0, 45, 90, 135, 180, 225, 270, 315].map((a) => {
      const r = (a * Math.PI) / 180;
      return `<line x1="${16 + 9 * Math.cos(r)}" y1="${16 + 9 * Math.sin(r)}" x2="${16 + 12 * Math.cos(r)}" y2="${16 + 12 * Math.sin(r)}"/>`;
    }).join("")}</g>`;
  const LUNA = `<path d="M20 5a11 11 0 1 0 7 19A9 9 0 0 1 20 5z" fill="#8f98ad"/>`;
  const nube = (x: number, y: number, s: number, color: string) =>
    `<path transform="translate(${x} ${y}) scale(${s})" d="M7 20h17a6 6 0 0 0 0-12 8 8 0 0 0-15-1A6.5 6.5 0 0 0 7 20z" fill="${color}"/>`;
  const gotas = (k: number, color: string) =>
    Array.from({ length: k }, (_, i) => {
      const x = 9 + i * (k > 3 ? 4.5 : 6) + (k === 1 ? 6 : 0);
      return `<line x1="${x}" y1="23" x2="${x - 2}" y2="${k >= 3 ? 30 : 28}" stroke="${color}" stroke-width="2" stroke-linecap="round"/>`;
    }).join("");
  const RAYO = `<path d="M17 18l-4 7h4l-2 6 7-9h-4l2-4z" fill="#f2b233" stroke="#7a5a00" stroke-width="0.6"/>`;

  function icono(sky: string, isDay: boolean, nivel: number, tam = 32): string {
    const astro = isDay ? SOL : LUNA;
    let dentro = "";
    if (nivel >= 5 || /thunder/.test(sky)) dentro = nube(0, -2, 1, "#7d8594") + gotas(2, "#3b74b8") + RAYO;
    else if (/snow/.test(sky)) dentro = nube(0, -2, 1, "#aab2bf") + `<text x="9" y="30" font-size="9" fill="#5d86b8">✻ ✻</text>`;
    else if (nivel >= 1) {
      const gris = nivel >= 3 ? "#8a919d" : "#b3b9c3";
      const cielo = nivel <= 2 && /^(light)?rainshowers|fair|partly/.test(sky)
        ? `<g transform="translate(-4 -5) scale(0.7)">${astro}</g>` : "";
      dentro = cielo + nube(0, -2, 1, gris) + gotas(Math.min(nivel, 4), nivel >= 4 ? "#24589b" : "#3b74b8");
    } else if (/fog/.test(sky)) dentro = nube(0, -4, 1, "#c4c9d1") +
      `<g stroke="#9aa1ab" stroke-width="2" stroke-linecap="round"><line x1="5" y1="24" x2="27" y2="24"/><line x1="8" y1="28" x2="24" y2="28"/></g>`;
    else if (/^cloudy/.test(sky)) dentro = nube(0, 2, 1, "#b8bec8");
    else if (/partlycloudy|fair/.test(sky)) dentro = `<g transform="translate(-3 -4) scale(${/fair/.test(sky) ? 0.9 : 0.8})">${astro}</g>` +
      (/fair/.test(sky) ? nube(10, 10, 0.6, "#d3d7de") : nube(4, 6, 0.85, "#c9ced6"));
    else dentro = astro;
    return `<svg xmlns="${SVG}" viewBox="0 0 32 32" width="${tam}" height="${tam}" aria-hidden="true">${dentro}</svg>`;
  }

  const textoCielo = (sky: string, isDay: boolean, nivel: number, label: string) => {
    if (nivel > 0) return label;
    if (/^cloudy/.test(sky)) return "Nublado";
    if (/partlycloudy/.test(sky)) return "Parcialmente nublado";
    if (/fair/.test(sky)) return "Poco nublado";
    if (/fog/.test(sky)) return "Niebla";
    return isDay ? "Despejado" : "Cielo despejado";
  };

  const raiz = document.querySelector<HTMLElement>("[data-tiempo]");
  if (raiz) {
    const $ = <T extends Element>(sel: string) => raiz.querySelector<T>(sel)!;
    const t = <T extends Element = HTMLElement>(nombre: string) => $<T>(`[data-t="${nombre}"]`);
    const select = $<HTMLSelectElement>("[data-tiempo-municipio]");
    const estado = $<HTMLElement>("[data-tiempo-estado]");
    const reintentar = $<HTMLButtonElement>("[data-tiempo-reintentar]");
    const cuerpo = $<HTMLElement>("[data-tiempo-cuerpo]");
    const diasCaja = $<HTMLElement>("[data-tiempo-dias-caja]");
    const barra = t<HTMLInputElement>("barra");
    const svg = t<SVGSVGElement>("grafica");
    let datos: Clima | null = null;
    let diaElegido = "";
    let lista: Periodo[] = [];

    const elemento = (nombre: string, attrs: Record<string, string | number>, texto?: string) => {
      const e = document.createElementNS(SVG, nombre);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (texto !== undefined) e.textContent = texto;
      return e;
    };

    // ---------- lectura de la hora elegida
    const leer = (i: number) => {
      const p = lista[i];
      if (!p || !datos) return;
      const ini = new Date(p.time);
      const fin = new Date(ini.getTime() + p.periodHours * 3600000);
      const hoy = diaLocal.format(new Date());
      const dia = diaLocal.format(ini);
      t("lugar").textContent = datos.name;
      t("cuando").textContent = `${dia === hoy ? "Hoy" : mayuscula(diaFmt.format(ini))} · ${horaFmt.format(ini)} · ${MOMENTO[p.phase] ?? ""}`;
      t("icono").innerHTML = icono(p.sky, p.isDay, p.rain.level, 64);
      t("temp").textContent = String(Math.round(p.temperature));
      t("cielo").textContent = textoCielo(p.sky, p.isDay, p.rain.level, p.rain.label);
      t("lluvia").textContent = p.rain.level === 0 ? "Sin lluvia prevista"
        : `Entre ${horaFmt.format(ini)} y ${horaFmt.format(fin)}`;
      t("viento").textContent = `Viento: ${n(p.wind)} km/h`;
      const d = datos.days.find((x) => x.date === dia);
      t("rango").textContent = d ? `Máx. ${n(d.maximum)}° · mín. ${n(d.minimum)}°` : "";
      t("sol").textContent = d ? `Sale el sol ${horaFmt.format(new Date(d.sunrise))} · se pone ${horaFmt.format(new Date(d.sunset))}` : "";
      t("hora-elegida").textContent = horaFmt.format(ini);
      barra.value = String(i);
      for (const m of svg.querySelectorAll("[data-sel]")) m.remove();
      const ancho = Number(svg.dataset.paso);
      const x = ancho * i + ancho / 2;
      const y = Number(svg.querySelectorAll("[data-punto]")[i]?.getAttribute("cy") ?? 0);
      svg.append(elemento("line", { x1: x, y1: 44, x2: x, y2: 168, stroke: "#ac202b", "stroke-dasharray": "3 3", "data-sel": 1 }));
      svg.append(elemento("circle", { cx: x, cy: y, r: 5.5, fill: "#ac202b", stroke: "#fff", "stroke-width": 2, "data-sel": 1 }));
      const caja = t<HTMLElement>("grafica-scroll");
      const visible = x - caja.scrollLeft;
      if (visible < 40 || visible > caja.clientWidth - 40) caja.scrollLeft = x - caja.clientWidth / 2;
    };

    // ---------- gráfica
    const graficar = () => {
      if (!datos) return;
      const hoy = diaLocal.format(new Date());
      lista = diaElegido && diaElegido !== hoy
        ? datos.periods.filter((p) => diaLocal.format(new Date(p.time)) === diaElegido)
        : datos.periods.slice(0, 24);
      const dia = datos.days.find((d) => d.date === (diaElegido || hoy));
      t("horas-titulo").textContent = diaElegido && diaElegido !== hoy
        ? `Horarios del ${diaFmt.format(new Date(diaElegido + "T12:00:00-06:00"))}` : "Próximas 24 horas";
      t("horas-sub").textContent = dia ? `${dia.date === hoy ? "Hoy" : "Ese día"}: ${dia.rain.level ? dia.rain.label.toLowerCase() : "sin lluvia prevista"}` : "";
      const paso = lista.some((p) => p.periodHours > 1) ? 70 : 48;
      const W = Math.max(lista.length * paso, 320);
      const H = 200;
      svg.dataset.paso = String(paso);
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.setAttribute("width", String(W));
      svg.setAttribute("height", String(H));
      svg.replaceChildren();
      const temps = lista.map((p) => p.temperature);
      const lo = Math.min(...temps) - 1, hi = Math.max(...temps) + 1;
      const y = (v: number) => 128 - ((v - lo) / (hi - lo || 1)) * 62;
      const FRANJA: Record<string, string> = { madrugada: "#e7e9f0", "mañana": "#fbf4e4", tarde: "#f8ecdb", noche: "#e2e5ee" };
      lista.forEach((p, i) => svg.append(elemento("rect", { x: i * paso, y: 0, width: paso, height: 172, fill: FRANJA[p.phase] ?? "#fff" })));
      let previa = "";
      lista.forEach((p, i) => {
        const x0 = i * paso;
        if (p.phase !== previa) {
          svg.append(elemento("text", { x: x0 + 4, y: 12, class: "g-momento" }, MOMENTO[p.phase] ?? ""));
          if (i > 0) svg.append(elemento("line", { x1: x0, y1: 0, x2: x0, y2: 172, stroke: "#d6d1c7" }));
          previa = p.phase;
        }
      });
      // dibujo del cielo en cada hora: cambia con el sol, la luna, las nubes y la intensidad de la lluvia
      lista.forEach((p, i) => {
        const g = elemento("g", { transform: `translate(${i * paso + paso / 2 - 13} 16)` });
        g.innerHTML = icono(p.sky, p.isDay, p.rain.level, 26);
        svg.append(g);
      });
      // área y línea de temperatura
      const pts = lista.map((p, i) => [i * paso + paso / 2, y(p.temperature)]);
      svg.append(elemento("path", { d: `M${pts[0][0]} 168 L${pts.map((q) => q.join(" ")).join(" L")} L${pts[pts.length - 1][0]} 168 Z`, fill: "rgba(196,134,60,0.18)" }));
      svg.append(elemento("polyline", { points: pts.map((q) => q.join(",")).join(" "), fill: "none", stroke: "#b07a33", "stroke-width": 2.5, "stroke-linejoin": "round" }));
      pts.forEach(([x, yy], i) => {
        svg.append(elemento("circle", { cx: x, cy: yy, r: 2.5, fill: "#b07a33", "data-punto": 1 }));
        if (lista.length <= 12 || i % 2 === 0) svg.append(elemento("text", { x, y: yy - 9, class: "g-temp" }, `${Math.round(lista[i].temperature)}°`));
      });
      // lluvia: barras de intensidad
      lista.forEach((p, i) => {
        if (!p.rain.level) return;
        const h = [0, 4, 8, 13, 18, 22][p.rain.level];
        const r = elemento("rect", { x: i * paso + paso / 2 - 9, y: 168 - h, width: 18, height: h, rx: 2,
          fill: p.rain.level >= 5 ? "#5b4a9e" : p.rain.level >= 4 ? "#24589b" : "#5b8fc9" });
        r.append(elemento("title", {}, p.rain.label));
        svg.append(r);
      });
      // horas
      lista.forEach((p, i) => {
        if (lista.length > 12 && i % 2 !== 0) return;
        svg.append(elemento("text", { x: i * paso + paso / 2, y: 188, class: "g-hora" },
          p.periodHours > 1 ? `${horaCorta.format(new Date(p.time))}` : horaCorta.format(new Date(p.time))));
      });
      // tocar la gráfica elige la hora
      const zona = elemento("rect", { x: 0, y: 0, width: W, height: H, fill: "transparent", style: "cursor:pointer" });
      zona.addEventListener("click", (ev) => {
        const caja = svg.getBoundingClientRect();
        leer(Math.min(lista.length - 1, Math.max(0, Math.floor(((ev as MouseEvent).clientX - caja.left) / (caja.width / lista.length)))));
      });
      svg.append(zona);
      barra.max = String(lista.length - 1);
      t<HTMLElement>("grafica-scroll").scrollLeft = 0;
      leer(0);
    };

    // ---------- días
    const pintarDias = () => {
      if (!datos) return;
      t("dias").replaceChildren(...datos.days.map((dia, i) => {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.setAttribute("aria-pressed", String(i === 0 ? !diaElegido : dia.date === diaElegido));
        b.innerHTML = `<span class="d"></span><span class="i"></span><span class="c"></span><strong></strong><span class="ll"></span>`;
        b.querySelector(".d")!.textContent = i === 0 ? "Hoy" : mayuscula(diaFmt.format(new Date(dia.date + "T12:00:00-06:00")));
        b.querySelector(".i")!.innerHTML = icono(dia.sky, true, dia.rain.level, 36);
        b.querySelector(".c")!.textContent = dia.rain.level ? dia.rain.label : textoCielo(dia.sky, true, 0, "");
        b.querySelector("strong")!.textContent = `${n(dia.maximum)}° / ${n(dia.minimum)}°`;
        b.querySelector(".ll")!.textContent = i === 0 && dia.partial ? "Desde la hora actual" : "";
        b.addEventListener("click", () => {
          diaElegido = i === 0 ? "" : dia.date;
          for (const otro of t("dias").querySelectorAll("button")) otro.setAttribute("aria-pressed", String(otro === b));
          graficar();
        });
        li.append(b);
        return li;
      }));
    };

    const cargar = async () => {
      const m = select.value;
      try { localStorage.setItem(LLAVE, m); } catch { /* sin almacenamiento */ }
      estado.classList.remove("oculto");
      estado.textContent = "Cargando el pronóstico…";
      reintentar.hidden = true;
      try {
        const r = await fetch(`/api/clima?municipio=${encodeURIComponent(m)}`);
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Sin pronóstico");
        if (select.value !== m) return; // cambió de municipio mientras cargaba
        datos = d;
        diaElegido = "";
        cuerpo.hidden = false;
        diasCaja.hidden = false;
        t<HTMLAnchorElement>("fuente").href =
          `https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=${d.latitude}&lon=${d.longitude}`;
        t("actualizado").textContent = d.updatedAt
          ? `Fuente actualizada: ${fechaFmt.format(new Date(d.updatedAt))} · hora de Nuevo León. En los días: máxima / mínima de los intervalos disponibles.` : "";
        pintarDias();
        graficar();
        estado.textContent = `Pronóstico de ${d.name} disponible.`;
        estado.classList.add("oculto");
      } catch (e) {
        estado.textContent = `No se pudo cargar el pronóstico. ${e instanceof Error ? e.message : ""}`;
        reintentar.hidden = false;
        cuerpo.hidden = true;
        diasCaja.hidden = true;
      }
    };

    barra.addEventListener("input", () => leer(Number(barra.value)));
    t("antes").addEventListener("click", () => leer(Math.max(0, Number(barra.value) - 1)));
    t("despues").addEventListener("click", () => leer(Math.min(lista.length - 1, Number(barra.value) + 1)));

    let guardado = "";
    try { guardado = localStorage.getItem(LLAVE) ?? ""; } catch { /* sin almacenamiento */ }
    // En la página de un municipio manda ese municipio; en la portada, el último consultado.
    if (raiz.dataset.inicial === "monterrey" && guardado && [...select.options].some((o) => o.value === guardado)) {
      select.value = guardado;
    }
    select.addEventListener("change", cargar);
    reintentar.addEventListener("click", cargar);
    cargar();
  }
</script>

<style>
  .tiempo { border-top: 1px solid var(--linea); padding-top: 40px; }
  .cabeza { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 18px; margin-bottom: 22px; }
  .cabeza h2 { font-size: clamp(1.6rem, 4vw, 2.1rem); }
  .sub { margin: 6px 0 0; color: var(--tinta-suave); font-size: 0.9rem; }
  .selector { display: grid; gap: 6px; min-width: min(100%, 260px); }
  .selector span { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .selector select { font: inherit; font-size: 0.95rem; color: var(--tinta); background: #fff; border: 1px solid var(--linea);
                     border-radius: 2px; padding: 10px 12px; }
  .estado { color: var(--tinta-suave); margin: 0 0 12px; }
