---
import Base from "../layouts/Base.astro";
---

<Base titulo="Página no encontrada">
  <section class="contenedor no-encontrada">
    <p class="antetitulo">Error 404</p>
    <h1>No encontramos esta página.</h1>
    <p>Puede que la dirección esté mal escrita o que la nota se haya movido.</p>
    <p><a href="/">Volver a la portada</a></p>
  </section>
</Base>

<style>
  .no-encontrada { padding-top: 64px; max-width: 720px; }
  h1 { font-size: clamp(2rem, 6vw, 2.8rem); letter-spacing: -0.04em; margin-bottom: 16px; }
  a { color: var(--rojo); font-weight: 600; }
</style>
