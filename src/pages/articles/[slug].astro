---
import { hoyEnMonterrey } from "../../lib/agenda.js";
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Sello from "../../components/Sello.astro";
import { fechaHora, fechaSinHora } from "../../lib/fechas";
import { notasPublicadas, type Nota } from "../../lib/notas";
import { nombreCategoria, nombreMunicipio } from "../../lib/sitio";
import { proyectoDeNota } from "../../lib/seguimiento";

export async function getStaticPaths() {
  const notas = await notasPublicadas();
  return notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

interface Props { nota: Nota }
const { nota } = Astro.props;
const { data } = nota;
const { Content } = await render(nota);
const expediente = await proyectoDeNota(nota.id);
// Un evento que ya pasó no se ofrece para el calendario (el navegador lo vuelve a revisar con la fecha de hoy).
const eventoPasado = data.evento ? (data.evento.fin ?? data.evento.inicio) < hoyEnMonterrey() : false;
const compartir = data.foto ? (await getImage({ src: data.foto.archivo, width: 1200, format: "jpg" })).src : undefined;
---

<Base titulo={data.titulo} descripcion={data.descripcion} activo={data.municipio} tipo="article"
      imagen={compartir} publicado={data.publicado}>
  <article class="contenedor nota">
    <a class="volver" href={`/municipios/${data.municipio}`}>← Volver a noticias</a>
    <p class="etiquetas">
      <a href={`/municipios/${data.municipio}`}>{nombreMunicipio(data.municipio)}</a>
      <span aria-hidden="true">·</span>
      <a href={`/categorias/${data.categoria}`}>{nombreCategoria(data.categoria)}</a>
    </p>
    <h1>{data.titulo}</h1>
    <p class="descripcion">{data.descripcion}</p>
    <p class="firma">
      {data.autor} · Publicado el <time datetime={data.publicado.toISOString()}>{fechaHora(data.publicado)}</time>
    </p>
    <p class="firma">
      Fecha del comunicado original: <time datetime={data.fecha_original}>{fechaSinHora(data.fecha_original)}</time>
    </p>
    {data.automatica && (
      <p class="automatica">
        Nota redactada automáticamente a partir del
        <a href={data.fuente.url} target="_blank" rel="noopener noreferrer">comunicado oficial del {data.fuente.nombre} ↗</a>
        y revisada contra él por un sistema. Si ves un error, <a href="/about">avísanos</a>.
      </p>
    )}

    <figure>
      {data.foto ? (
        <>
          <Image src={data.foto.archivo} alt={data.foto.alt} widths={[480, 800, 1200]}
                 sizes="(max-width: 800px) 100vw, 760px" loading="eager" />
          <figcaption>
            Foto: {data.foto.credito}
            {data.foto.original && (
              <> · <a href={data.foto.original} target="_blank" rel="noopener noreferrer">Ver imagen original ↗</a></>
            )}
          </figcaption>
        </>
      ) : (
        <div class="sin-foto"><Sello municipio={nombreMunicipio(data.municipio)} /></div>
      )}
    </figure>

    {data.evento && (
      <aside class="evento" aria-label="Datos del evento">
        <p class="antetitulo">Evento</p>
        <p><strong>Cuándo:</strong> {data.evento.fecha}</p>
        {data.evento.lugar && <p><strong>Dónde:</strong> {data.evento.lugar}</p>}
        <p class="acciones-evento">
          {!eventoPasado && (
            <a href={`/agenda/${nota.id}.ics`} download data-calendario-nota data-fin={data.evento.fin ?? data.evento.inicio}>
              Añadir a mi calendario
            </a>
          )}
          <a href="/agenda">Ver la agenda</a>
        </p>
      </aside>
    )}

    <div class="prosa"><Content /></div>

    {expediente && (
      <aside class="seguimiento" aria-label="Seguimiento">
        <p class="antetitulo">Seguimiento</p>
        <p>Esta nota forma parte de un expediente: <a href={`/proyectos/${expediente.id}`}>{expediente.data.titulo}</a>.
           Ahí se registran los hitos documentados y lo que falta por confirmar.</p>
      </aside>
    )}

    <p class="fuente">
      Fuente oficial: <a href={data.fuente.url} target="_blank" rel="noopener noreferrer">{data.fuente.nombre} ↗</a>
    </p>
  </article>
</Base>

<script>
  import { hoyEnMonterrey } from "../../lib/agenda.js";
  const enlace = document.querySelector<HTMLElement>("[data-calendario-nota]");
  if (enlace && enlace.dataset.fin! < hoyEnMonterrey()) enlace.remove();
</script>

<style>
  .nota { max-width: 820px; padding-top: 36px; }
  .volver { display: inline-block; margin-bottom: 22px; font-size: 0.85rem; color: var(--tinta-suave); text-decoration: none; }
  .volver:hover { color: var(--rojo); }
  h1 { font-size: clamp(1.9rem, 5vw, 2.7rem); letter-spacing: -0.035em; margin-top: 12px; }
  .descripcion { font-size: 1.15rem; color: var(--tinta-suave); margin: 16px 0 18px; line-height: 1.6; }
  .firma { margin: 4px 0; font-size: 0.85rem; color: var(--tinta-suave); }
  figure { margin: 28px 0; }
  figure :global(img) { width: 100%; height: auto; }
  .sin-foto { aspect-ratio: 16 / 7; }
  figcaption { margin-top: 10px; font-size: 0.8rem; color: var(--tinta-suave); }
  figcaption a { color: inherit; }
  .evento {
    border-left: 4px solid var(--rojo); background: var(--papel-hondo);
    padding: 16px 20px; margin: 0 0 28px; max-width: 68ch;
  }
  .evento p { margin: 4px 0; }
  .evento .antetitulo { margin-bottom: 8px; }
  .acciones-evento { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 10px !important; font-size: 0.88rem; }
  .acciones-evento a { color: var(--rojo); font-weight: 600; }
  .seguimiento { border: 1px solid var(--linea); background: #fff; padding: 14px 18px; margin: 28px 0 0; max-width: 68ch; }
  .seguimiento p { margin: 4px 0; }
  .seguimiento a { color: var(--rojo); font-weight: 600; }
  .automatica {
    margin: 14px 0 0; padding: 10px 14px; border-left: 3px solid var(--tinta-suave); background: var(--papel-hondo);
    font-size: 0.82rem; color: var(--tinta-suave); line-height: 1.5;
  }
  .automatica a { color: var(--tinta); }
  .fuente { margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--linea); font-size: 0.92rem; }
  .fuente a { color: var(--rojo); font-weight: 600; }
</style>
